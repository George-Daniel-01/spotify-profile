{
  "name": "spotify-profile",
  "version": "0.1.0",
  "description": "Spotify Profile",
  "main": "server/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/George-Daniel-01/spotify-profile.git"
  },
  "keywords": [],
  "author": "Brittany Chiang <brittany.chiang@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/George-Daniel-01/spotify-profile/issues"
  },
  "homepage": "https://github.com/George-Daniel-01/spotify-profile#readme",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "client:install": "cd client && yarn",
    "client": "cd client && yarn start",
    "server": "node server",
    "dev": "concurrently --kill-others-on-fail \"yarn server\" \"yarn client\"",
    "start": "node server",
    "heroku-postbuild": "cd client/ && yarn && yarn install --production && yarn build",
    "test:api": "node tests/api-smoke.js",
    "test:e2e": "node tests/e2e-local.js",
    "test": "npm run test:api && npm run test:e2e"
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.{js}": [
      "eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "connect-history-api-fallback": "^1.6.0",
    "cookie-parser": "1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^8.1.0",
    "express": "~4.17.1",
    "querystring": "~0.2.0",
    "request": "~2.88.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  },
  "directories": {
    "test": "tests"
  }
}
